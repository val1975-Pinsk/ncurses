public class Calculator{

    public static void main (String[] args){

        double totalConsumption = 0;

        Distance route = new Distance ("трасса");
        Distance Pinsk = new Distance ("Пинск");
        Distance direct = new Distance (System.console().readLine("Пункт назначения: "));

        route.getValue();
        Pinsk.getValue();
        direct.getValue();
        String cityFuelNorma = System.console().readLine("1.Норма расхода с населением 100-300 тыс.\t33.0\n2.Норма расхода с населением 300 тыс - 1 млн.\t33.6\n3.Норма расхода с населением 1 - 3 млн.\t\t35.2\nВведите норму расхода(1, 2, 3): ");
        switch(cityFuelNorma){
            case "1":
                cityFuelNorma = "33.0";
                break;
            case "2":
                cityFuelNorma = "33.6";
                break;
            case "3":
                cityFuelNorma = "35.2";
        }
        String webasto = System.console().readLine("Работа отопителя часов: ");

        route.calculateConsumption (30.4);
        route.printConsumption ();
        totalConsumption += route.returnConsumption();

        Pinsk.calculateConsumption (33.0);
        Pinsk.printConsumption ();
        totalConsumption += Pinsk.returnConsumption();

        direct.calculateConsumption (Double.parseDouble(cityFuelNorma));
        direct.printConsumption ();
        totalConsumption += direct.returnConsumption();

        System.out.printf ("Расход отопитель\t%.2f л.\n", Double.parseDouble(webasto) * 2);
        System.out.printf ("Общий пробег \t\t%d км.\n", route.returnValue() + Pinsk.returnValue() + direct.returnValue());
        System.out.printf ("общий расход \t\t%.2f л.\n", totalConsumption + Double.parseDouble(webasto) * 2);
    }
}
